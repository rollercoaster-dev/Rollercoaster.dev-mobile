# Copy to .env in this directory (gitignored by the root .gitignore, never commit).
# Bun loads .env from the current directory automatically — no dotenv needed.
#
# Use a DEDICATED THROWAWAY TEST IDENTITY. Never a personal or production account:
# records on a PDS are public, propagate to the firehose, and may be mirrored
# by third parties before you delete them (atproto-evaluation.md, Risk 1).

# Hosted PDS. bsky.social is the reference implementation; any PDS works.
PDS_URL=https://bsky.social

# The account handle as Bluesky knows it, e.g. rd-spike-test.bsky.social
# (a domain handle only works once _atproto DNS / .well-known is set up)
PDS_HANDLE=

# App password from Settings → Privacy and security → App passwords.
# NOT the account password. Revoke it when the spike is done.
PDS_APP_PASSWORD=
